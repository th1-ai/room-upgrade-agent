{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash({{PMS_LOOKUP_TOOL}} *)",
      "Bash({{PMS_RATES_TOOL}} *)",
      "Bash({{EMAIL_CLI}} *)",
      "Edit(runs/**)",
      "Edit(.claude/agent-memory/room-upgrade/**)"
    ],
    "deny": [
      "Bash({{PMS_RESERVATION_TOOL}} *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Edit(AUTONOMY.md)",
      "Edit(.claude/settings*.json)",
      "Edit(.claude/hooks/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/autonomy-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
