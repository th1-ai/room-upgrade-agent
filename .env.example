# Room Upgrade Agent: setup values
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
#
# Each name below matches a {{PLACEHOLDER}} in the agent and skill files.
# The first-run setup prompt in the README reads this file and writes the
# values into those files. Nothing else reads it: API keys and passwords
# for your PMS and email tools belong to those tools, not here.

# ============================================================
# Hotel identity
# ============================================================

HOTEL_NAME="Your Hotel Name"
OPERATOR_NAME="Your Name"

# ============================================================
# Email
# ============================================================
# The agent creates drafts. It sends an offer only if you set Level 3 in
# AUTONOMY.md.

INBOX_BOOKINGS="bookings@yourhotel.example"
EMAIL_CLI="your-email-cli"

# ============================================================
# PMS (Property Management System)
# ============================================================
# Your own scripts or CLIs. See "What you need" in the README for
# the sub-commands the skill expects.

PMS_PROPERTY_ID=""
PMS_LOOKUP_TOOL="tools/pms_lookup.py"
PMS_RATES_TOOL="tools/pms_rates.py"
PMS_RESERVATION_TOOL="tools/pms_reservation.py"

# How your PMS reads the amount of a rate adjustment. Test it once on a
# test reservation, then write the result here, for example:
# "positive amount = discount" or "negative amount = discount"
PMS_ADJUSTMENT_SIGN=""

# ============================================================
# Upgrade catalogue
# ============================================================
# The PMS item ID for the "Room upgrade" line item, and the price
# per night for each tier of the pricing table in the skill.

UPGRADE_ITEM_ID=""
UPGRADE_PRICE_PER_NIGHT_TIER1="20"
UPGRADE_PRICE_PER_NIGHT_TIER2="30"

# ============================================================
# Optional: sheet that logs every offer, so no guest is offered twice
# ============================================================

SHEET_ID_UPGRADES=""
