# Room Upgrade Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# Hotel identity
# ============================================================

HOTEL_NAME="Your Hotel Name"
OPERATOR_NAME="Your Name"

# ============================================================
# Email accounts the agent will draft from
# ============================================================
# The agent NEVER sends — only creates drafts.

INBOX_BOOKINGS="bookings@yourhotel.com"

EMAIL_CLI="gws gmail"

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# Tools the agent uses to look up reservations, check availability,
# change room types, post charges, and post rate adjustments.

PMS_PROPERTY_ID="{{PMS_PROPERTY_ID}}"
PMS_LOOKUP_TOOL="tools/pms_lookup.py"
PMS_RATES_TOOL="tools/pms_rates.py"
PMS_RESERVATION_TOOL="tools/pms_reservation.py"

# ============================================================
# Upgrade catalogue
# ============================================================
# The PMS item ID for the "room upgrade" line item that gets
# added to the reservation, and its per-night price.

UPGRADE_ITEM_ID="<UPGRADE_ITEM_ID>"
UPGRADE_PRICE_PER_NIGHT_TIER1="20"
UPGRADE_PRICE_PER_NIGHT_TIER2="30"

# ============================================================
# Optional — log every offer to a sheet so you don't re-offer
# ============================================================

# SHEET_ID_UPGRADES=""
